# Generate a real token with: openssl rand -hex 32
PI_AGENT_TOKEN=changeme

# --- Daily S3 report (optional, see README "Daily fleet report") ---
# Same bucket name on every Pi.
PI_REPORT_BUCKET=your-pi-reports-bucket
# Defaults to the machine's hostname if unset.
PI_REPORT_HOSTNAME=
# Only used by aggregate_report.py: how old a Pi's last snapshot can be
# before it's flagged STALE on the combined report.
PI_REPORT_STALE_HOURS=36
